        "jsCode": "const item = $input.first().json;\nconst minSec = 60;\nconst maxSec = 180;\nconst delaySec = Math.floor(Math.random() * (maxSec - minSec + 1)) + minSec;\nreturn [{ json: { ...item, delayMs: delaySec * 1000, delaySec } }];"
      },
