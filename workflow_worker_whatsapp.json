      ],
      "parameters": {
        "jsCode": "const minDelay = 1;\nconst maxDelay = 30;\nconst randomMin = Math.floor(Math.random() * (maxDelay - minDelay + 1)) + minDelay;\nreturn [{ json: { delayMs: randomMin * 60 * 1000, randomMin } }];"
