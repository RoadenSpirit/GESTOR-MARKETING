    {
      "id": "get-target-group",
      "name": "Get Target Group",
      "type": "n8n-nodes-base.postgres",
      "position": [
        700,
        500
      ],
      "parameters": {
        "query": "SELECT id AS target_group_id, nombre AS target_group_name FROM whatsapp_groups WHERE activo = true ORDER BY ultimo_envio ASC NULLS FIRST, orden ASC LIMIT 1;",
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "qq6LeroBSIWTFfx2",
          "name": "postgres_carmay"
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "970ae496-3085-423e-affe-da2eeef9173e",
      "name": "Get Pending Batch",
      "type": "n8n-nodes-base.postgres",
      "position": [
        900,
        500
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT id, producto, drive_id FROM whatsapp_queue q WHERE ((q.estado = 'PENDIENTE' AND NOT ('{{ $('Get Target Group').item.json.target_group_id }}' = ANY(q.grupos_enviados))) OR (q.estado = 'FALLIDO' AND q.fecha_envio <= NOW() - INTERVAL '24 hours' AND NOT ('{{ $('Get Target Group').item.json.target_group_id }}' = ANY(q.grupos_enviados)))) AND q.drive_id IS NOT NULL AND length(q.drive_id) >= 25 ORDER BY CASE WHEN q.estado = 'PENDIENTE' THEN 0 ELSE 1 END ASC, q.id ASC LIMIT 3;"
      },
      "credentials": {
        "postgres": {
          "id": "qq6LeroBSIWTFfx2",
          "name": "postgres_carmay"
        }
      },
      "typeVersion": 2.2
    },
