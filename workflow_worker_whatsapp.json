      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO whatsapp_sent_log (producto, drive_id, group_id) VALUES ('{{ ($('Loop Batch').item.json.producto || '').replace(/'/g, \"''\") }}', '{{ $('Loop Batch').item.json.drive_id }}', '{{ $('Get Target Group').item.json.target_group_id }}'); UPDATE whatsapp_queue SET grupos_enviados = array_append(grupos_enviados, '{{ $('Get Target Group').item.json.target_group_id }}'), estado = CASE WHEN (SELECT count(*) FROM whatsapp_groups WHERE activo = true) <= array_length(array_append(grupos_enviados, '{{ $('Get Target Group').item.json.target_group_id }}'), 1) THEN 'COMPLETADO' ELSE 'PENDIENTE' END, fecha_envio = CASE WHEN (SELECT count(*) FROM whatsapp_groups WHERE activo = true) <= array_length(array_append(grupos_enviados, '{{ $('Get Target Group').item.json.target_group_id }}'), 1) THEN NOW() ELSE fecha_envio END WHERE id = {{ $('Loop Batch').item.json.id }};"
      },
